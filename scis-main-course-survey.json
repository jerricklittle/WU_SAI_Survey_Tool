{
  "schemaVersion": "1.0.0",
  "title": "SCIS Main Course Survey",
  "description": "Willamette University SCIS Main Course Survey",
  "surveyVersion": 1,
  "questions": [
    {
      "id": "q1",
      "version": 1,
      "type": "multi",
      "prompt": "What were your reasons for taking this course? (Please check all that apply.)",
      "required": true,
      "order": 1,
      "options": [
        "Required for major / minor",
        "Counts toward major / minor",
        "Fulfills Gen.Ed. Requirement",
        "Topic interested me",
        "Other"
      ]
    },
    {
      "id": "q2",
      "version": 1,
      "type": "likert",
      "prompt": "How often did you come prepared for class?",
      "required": true,
      "order": 2,
      "allowComment": false,
      "scale": {
        "min": 1,
        "max": 5,
        "labels": {
          "1": "Never",
          "2": "Some of the time",
          "3": "Often",
          "4": "Almost always",
          "5": "Always"
        }
      }
    },
    {
      "id": "q3",
      "version": 1,
      "type": "likert",
      "prompt": "Please indicate the extent to which you Agree or Disagree with this statement: The subject matter of this class was what I expected it to be at the beginning of the course.",
