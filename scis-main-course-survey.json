      "order": 3,
      "allowComment": false,
      "scale": {
        "min": 1,
        "max": 5,
        "labels": {
          "1": "Strongly Disagree",
          "2": "Disagree",
          "3": "Neutral",
          "4": "Agree",
          "5": "Strongly Agree"
        }
